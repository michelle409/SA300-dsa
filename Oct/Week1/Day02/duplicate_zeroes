# Problem: Duplicate Zeros
# Pattern: In-place modification using a temporary list
# Time: O(n) | Space: O(n)

def duplicateZeros(arr):
    temp = []
    for i in range(len(arr)):
        temp.append(arr[i])
        if arr[i] == 0:
            temp.append(0)
    for i in range(len(arr)):
        arr[i] = temp[i]

arr1 = [1,0,2,3,0,4,5,0]
duplicateZeros(arr1)
print(arr1)  # [1,0,0,2,3,0,0,4]

arr2 = [1,2,3]
duplicateZeros(arr2)
print(arr2)  # [1,2,3]